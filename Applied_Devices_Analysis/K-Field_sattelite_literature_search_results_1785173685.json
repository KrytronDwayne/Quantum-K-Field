      "reference-point motion",
      "restricted empirical harmonics"
    ]
  },
  "derived_equations": {
    "rtn_projection": [
      "a_R = a_p cos(u) + a_q sin(u)",
      "a_T = -a_p sin(u) + a_q cos(u)",
      "a_N = a_h"
    ],
    "two_per_rev_identity": "cos^2(u) = [1 + cos(2u)]/2",
    "velocity_amplitude": "v_amp = A T/(2 pi)",
    "displacement_amplitude": "x_amp = A T^2/(4 pi^2)",
    "parity": [
      "q_K(-omega) = -q_K(omega)",
      "q_imbalance(-omega) = q_imbalance(omega)"
    ]
  },
