  "scope": {
    "question": "Identify periodic or recurrent spacecraft tracking and trajectory terms associated with reaction-wheel operation and define a decisive signed-wheel K-Field test.",
    "twelve_hour_constraint": "Approximately twelve hours is orbital only for a near-12-hour 1/rev orbit or a derived harmonic such as GEO 2/rev. Operational cadence and estimator spacing are separate.",
    "evidence_layers": [
      "published observation",
      "published processing choice",
      "derived orbital mapping",
      "inferred mechanism",
      "proposed K-Field test"
    ]
  },
  "central_findings": [
    "The literature contains wheel-speed structural disturbances, real momentum-unloading Delta-v events, and empirical orbital acceleration terms.",
    "GRAIL provides the strongest direct published wheel-speed correlation in precision tracking near approximately 100 Hz.",
    "Odyssey and RadioAstron report unloading Delta-v values of several millimeters per second.",
    "GPS and GLONASS place 1/rev fundamentals near twelve hours; GEO places 2/rev near twelve hours while 1/rev is one sidereal day.",
    "No reviewed publication performs a joint signed-wheel inertial-orientation translational regression with all required controls.",
    "GRAIL is the strongest public archival test; telemetry-enabled GNSS and GEO are the strongest approximately twelve-hour orbital-harmonic tests."
  ],
  "effect_classes": [
    {
      "id": "structural_wheel_harmonics",
      "pathway": "imbalance, bearings, motor ripple, cogging, resonance",
      "signature": "wheel-angle lines and reference-point motion",
      "center_of_mass": "not ordinarily sustained translation"
    },
    {
      "id": "momentum_unloading",
      "pathway": "external actuator removes stored momentum",
      "signature": "event-synchronous finite burn or Delta-v",
      "center_of_mass": "real change for thruster unloading"
    },
    {
      "id": "empirical_orbit_acceleration",
      "pathway": "estimator absorbs force deficiencies",
      "signature": "constant, harmonic, or pseudo-stochastic coefficient",
      "center_of_mass": "may contain real force, error, or candidate term"
    }
  ],
