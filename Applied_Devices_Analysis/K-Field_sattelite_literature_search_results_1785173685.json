    "per_wheel_angular_momentum": "H_i^I = R_I<-B I_i omega_i n_i,B",
    "minimal_odd_lateral_proxy": "q_K^I = sum_i I_i omega_i [n_i^I x g_hat_K]",
    "candidate_acceleration": "a_K^I = alpha_K q_K^I",
    "required_properties": [
      "continuous between unloads",
      "odd in signed wheel speed",
      "phase-locked to inertial orientation",
      "stable across attitudes, arcs, and spacecraft"
