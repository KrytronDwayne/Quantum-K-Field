    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#quantum-k-field",
      "@type": "skos:Concept",
      "skos:prefLabel": "Quantum K-Field",
      "skos:definition": "Research framework/archive term for the project-wide observational, geometric, metrological and derived research corpus.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#cell3",
      "@type": "skos:Concept",
      "skos:prefLabel": "Cell3",
      "skos:definition": "Archive name for the corrected oriented rhombohedral primitive-cell model represented by three basis vectors and associated direct/reciprocal metric structure.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#devon-dimension",
      "@type": "skos:Concept",
      "skos:prefLabel": "Devon Dimension",
      "skos:definition": "Archive name for the compact direct/reciprocal algebraic metric representation constructed from Cell3; dimension is historical terminology rather than an extra spatial dimension.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#mass-bridge",
      "@type": "skos:Concept",
      "skos:prefLabel": "Mass Bridge",
      "skos:definition": "Archive name for a projective closure formed from dimensionless ratios of primitive Cell3 face areas and downstream physical-quantity comparisons.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#lucas-limit",
      "@type": "skos:Concept",
      "skos:prefLabel": "Lucas Limit",
      "skos:definition": "Archive name for the centered 27-node address graph on {-1,0,1}^3, equivalent to the Cartesian-product graph P3 square P3 square P3.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#emily-eigen-spectrum",
      "@type": "skos:Concept",
      "skos:prefLabel": "Emily Eigen-spectrum",
      "skos:definition": "Archive name for the adjacency eigenspectrum of the finite Lucas graph.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      },
      "skos:altLabel": "Emily Eigenspectrum"
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#jack-jacobian",
      "@type": "skos:Concept",
      "skos:prefLabel": "Jack Jacobian",
      "skos:definition": "Archive name for a logarithmic perturbation/sensitivity Jacobian relating changes in primitive geometric directions to changes in selected derived quantities.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    },
    {
      "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#lucas-supergroup",
      "@type": "skos:Concept",
      "skos:prefLabel": "Lucas Supergroup",
      "skos:definition": "Historical archive name for the recursive 9 by 9 by 9 Cell3 aggregation used in later graph and volumetric studies; treated as a recursive finite cell complex, not an algebraic supergroup.",
      "skos:inScheme": {
        "@id": "https://krytrondwayne.github.io/Quantum-K-Field/machine_index/semantic/kfield-vocabulary.jsonld#scheme"
      }
    }
